import * as THREE from 'three';
import { scene, onDispose, isPreview } from '@drawcall/glts';
// Original palm-sized toy: 16 cm tall, +Y up, +Z face, soles at y=0.
// Oversized head, mitten hands and short boots are intentionally stylised.
const root=new THREE.Group();root.name='ArenaVoca pocket player';scene.add(root);
const materials=Object.fromEntries(Object.entries({shirt:'#1646ed',shorts:'#142352',skin:'#dca77d',hair:'#44352d',eye:'#292b35',sock:'#fff2da',boot:'#344363',cheek:'#e58e7d'}).map(([k,color])=>[k,new THREE.MeshStandardMaterial({color,roughness:.82})]));
function ellipsoid(name,mat,pos,size,parent=root){const g=new THREE.SphereGeometry(1,16,12);const m=new THREE.Mesh(g,materials[mat]);m.name=name;m.position.set(...pos);m.scale.set(...size);parent.add(m);return m;}
ellipsoid('Jersey','shirt',[0,.073,0],[.035,.041,.027]);
ellipsoid('Shirt stripe','shorts',[0,.077,.025],[.009,.029,.004]);
ellipsoid('Shorts','shorts',[0,.042,0],[.031,.019,.025]);
ellipsoid('Head','skin',[0,.124,.002],[.041,.037,.037]);
ellipsoid('Hair cap','hair',[0,.142,-.009],[.040,.021,.031]);
ellipsoid('Hair curl','hair',[-.018,.152,.012],[.020,.011,.018]);
for(const side of [-1,1]){
 const tag=side<0?'Left':'Right';
 ellipsoid(tag+' eye','eye',[side*.014,.127,.036],[.004,.005,.0025]);
 ellipsoid(tag+' cheek','cheek',[side*.026,.116,.031],[.006,.003,.002]);
 ellipsoid(tag+' sleeve','shirt',[side*.034,.082,0],[.014,.019,.017]);
 ellipsoid(tag+' mitten','skin',[side*.040,.062,.003],[.012,.015,.013]);
 const leg=new THREE.Group();leg.name=tag+' leg';root.add(leg);
 ellipsoid(tag+' sock','sock',[side*.017,.025,0],[.012,.019,.012],leg);
 ellipsoid(tag+' boot','boot',[side*.017,.011,.011],[.016,.011,.023],leg);
}
ellipsoid('Smile','eye',[0,.111,.036],[.008,.002,.0015]);
if(isPreview){scene.background=new THREE.Color('#eee9df');scene.add(new THREE.HemisphereLight(0xffffff,0x6d7291,2));const light=new THREE.DirectionalLight(0xffffff,3);light.position.set(1,2,3);scene.add(light);}
onDispose(()=>{root.traverse(o=>{if(o.isMesh)o.geometry.dispose()});Object.values(materials).forEach(m=>m.dispose());});
