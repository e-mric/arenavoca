{
  "name": "football-spanish-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --config vite.preview.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "content:prepare": "node scripts/prepare-content.mjs && node scripts/prepare-ui.mjs",
    "dev:http": "IWSDK_HTTP=1 vite",
    "format": "prettier --write src scripts/*.mjs *.ts *.json index.html",
    "format:check": "prettier --check src scripts/*.mjs *.ts *.json index.html"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.1",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.1",
    "@iwsdk/reference": "1.0.1",
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@meta-quest/metavr": "^1.8.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.181.0",
    "@vitest/coverage-v8": "^5.0.3",
    "prettier": "^3.9.10",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
