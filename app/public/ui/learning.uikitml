<style>
@font-face { font-family: 'Atkinson'; font-weight: 400; src: url('../fonts/AtkinsonHyperlegible-Regular.ttf'); font-weight: 400; }
.fs-root { font-family: 'Atkinson'; font-weight: 400; flex-direction: column; background-color: #1c2821; border-radius: 18px; padding: 24px; color: #edf3e8; gap: 12px; }
.fs-title { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #d5e5d0; }
.fs-body { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #b5c9b5; }
.fs-row { flex-direction: row; gap: 12px; align-items: center; justify-content: center; }
.fs-button { background-color: #304537; min-height: 62px; border-radius: 10px; padding: 10px; }
.fs-label { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #edf3e8; }
.fs-space { height: 275px; }
</style><div class="fs-root" style="width: 600px; height: 820px"><div id="xr-action-name" class="fs-title">THE PASS</div><div id="xr-learning-area" class="fs-space"></div><span id="xr-phrase" class="fs-title">Follow the play.</span><span id="xr-meaning" class="fs-body">A phrase appears during the replay.</span><div class="fs-row"><Button id="xr-listen" class="fs-button"><ButtonLabel id="xr-listen-label" class="fs-label">Listen</ButtonLabel></Button><Button id="xr-stop" class="fs-button"><ButtonLabel id="xr-stop-label" class="fs-label">Stop audio</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-save" class="fs-button"><ButtonLabel id="xr-save-label" class="fs-label">Save phrase</ButtonLabel></Button><Button id="xr-explore" class="fs-button"><ButtonLabel id="xr-explore-label" class="fs-label">Explore action</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-phrase-close" class="fs-button"><ButtonLabel id="xr-phrase-close-label" class="fs-label">Close phrases</ButtonLabel></Button></div><span id="xr-learning-status" class="fs-body"></span></div>