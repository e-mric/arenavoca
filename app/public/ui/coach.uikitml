<style>
@font-face { font-family: 'Atkinson'; font-weight: 400; src: url('../fonts/AtkinsonHyperlegible-Regular.ttf'); font-weight: 400; }
.fs-root { font-family: 'Atkinson'; font-weight: 400; flex-direction: column; background-color: #281922; border-radius: 26px; padding: 24px; color: #fff4ed; gap: 12px; }
.fs-title { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #ffe2d4; }
.fs-body { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #d8c1c9; }
.fs-row { flex-direction: row; gap: 12px; align-items: center; justify-content: center; }
.fs-button { background-color: #432c36; min-height: 62px; border-radius: 22px; padding: 10px; }
.fs-label { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #fff4ed; }
.fs-space { height: 275px; }
</style><div class="fs-root" style="width: 1000px; height: 1000px"><span class="fs-title">ARENAVOCA COACH / AI</span><span id="xr-coach-status" class="fs-title">Disconnected / microphone off</span><span id="xr-coach-phrase" class="fs-title"></span><span class="fs-body">Start voice shares speech with ElevenLabs. Text uses no microphone. Audio not stored; transcript kept one day.</span><span class="fs-body">Practice phrase only. No live commentary access.</span><div id="xr-coach-starts"><div class="fs-row"><Button id="xr-coach-voice" class="fs-button"><ButtonLabel id="xr-coach-voice-label" class="fs-label">Start voice</ButtonLabel></Button><Button id="xr-coach-text" class="fs-button"><ButtonLabel id="xr-coach-text-label" class="fs-label">Start text</ButtonLabel></Button></div></div><div id="xr-coach-actions" style="flex-direction: column; gap: 12px"><div class="fs-row"><Button id="xr-coach-explain" class="fs-button"><ButtonLabel id="xr-coach-explain-label" class="fs-label">Explain</ButtonLabel></Button><Button id="xr-coach-slow" class="fs-button"><ButtonLabel id="xr-coach-slow-label" class="fs-label">Say it slowly</ButtonLabel></Button><Button id="xr-coach-practice" class="fs-button"><ButtonLabel id="xr-coach-practice-label" class="fs-label">Let me try</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-coach-mic" class="fs-button"><ButtonLabel id="xr-coach-mic-label" class="fs-label">Speak a question</ButtonLabel></Button><Button id="xr-coach-spanish" class="fs-button"><ButtonLabel id="xr-coach-spanish-label" class="fs-label">Simple Spanish</ButtonLabel></Button></div></div><span id="xr-coach-reply" class="fs-body"></span><span id="xr-coach-page" class="fs-body"></span><div class="fs-row"><Button id="xr-coach-next" class="fs-button"><ButtonLabel id="xr-coach-next-label" class="fs-label">Next text</ButtonLabel></Button></div><span id="xr-coach-notice" class="fs-body"></span><div class="fs-row"><Button id="xr-coach-end" class="fs-button"><ButtonLabel id="xr-coach-end-label" class="fs-label">End session</ButtonLabel></Button><Button id="xr-coach-close" class="fs-button"><ButtonLabel id="xr-coach-close-label" class="fs-label">Close coach</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-coach-side" class="fs-button"><ButtonLabel id="xr-coach-side-label" class="fs-label">Other side</ButtonLabel></Button><Button id="xr-coach-distance" class="fs-button"><ButtonLabel id="xr-coach-distance-label" class="fs-label">Nearer / farther</ButtonLabel></Button><Button id="xr-coach-height" class="fs-button"><ButtonLabel id="xr-coach-height-label" class="fs-label">Higher / lower</ButtonLabel></Button></div></div>