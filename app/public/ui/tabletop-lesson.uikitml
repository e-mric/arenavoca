<style>
@font-face { font-family: 'Atkinson'; font-weight: 400; src: url('../fonts/AtkinsonHyperlegible-Regular.ttf'); }
.card { font-family: 'Atkinson'; font-weight: 400; width: 400px; height: 528px; padding: 22px; gap: 9px; background-color: #fffaf2; border-radius: 22px; flex-direction: column; }
.copy { font-size: 22px; color: #4e5268; }
.title { font-size: 34px; color: #142352; }
.row { flex-direction: row; gap: 10px; }
.action { background-color: #ece8fc; min-height: 52px; padding: 10px; border-radius: 18px; }
.label { font-size: 23px; color: #142352; }
</style>
<div class="card">
<span id="table-step" class="copy">01 / ESPAÑOL</span>
<span id="table-phrase" class="title">Pasa el balón hacia atrás.</span>
<span id="table-translation" class="copy">Turn me over for English</span>
<div id="table-feedback" style="height: 100px; padding: 12px; background-color: #ece8fc; border-radius: 16px"><span id="table-message" class="copy">Pull back. Aim. Release.</span></div>
<div id="table-actions" class="row"><Button id="table-hint" class="action"><ButtonLabel id="table-hint-label" class="label">Flip</ButtonLabel></Button><Button id="table-retry" class="action"><ButtonLabel id="table-primary" class="label">Reset ball</ButtonLabel></Button></div>
<div id="table-nav" class="row"><Button id="table-back" class="action"><ButtonLabel class="label">Cards</ButtonLabel></Button><Button id="table-close" class="action"><ButtonLabel class="label">Done</ButtonLabel></Button></div>
<Button id="table-atmosphere" class="action"><ButtonLabel id="table-atmosphere-label" class="label">Switch to Minimal</ButtonLabel></Button>
</div>
