<style>
@font-face { font-family: 'Atkinson'; font-weight: 400; src: url('../fonts/AtkinsonHyperlegible-Regular.ttf'); font-weight: 400; }
.fs-root { font-family: 'Atkinson'; font-weight: 400; flex-direction: column; background-color: #281922; border-radius: 26px; padding: 24px; color: #fff4ed; gap: 12px; }
.fs-title { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #ffe2d4; }
.fs-body { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #d8c1c9; }
.fs-row { flex-direction: row; gap: 12px; align-items: center; justify-content: center; }
.fs-button { background-color: #432c36; min-height: 62px; border-radius: 22px; padding: 10px; }
.fs-label { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #fff4ed; }
.fs-space { height: 275px; }
</style><div class="fs-root" style="width: 1000px; height: 900px"><div class="fs-title">ARENAVOCA / MATCHDAY</div><div id="xr-media-title" class="fs-body">Calibration clip / 30 seconds</div><div class="fs-body">Point and pinch buttons. Hold a blue handle to move; pull a gold corner to resize. Near you, pinch the peach grip with one or both hands.</div><span id="xr-welcome-status" class="fs-body">Preparing your match...</span><div class="fs-row"><Button id="xr-sport-football" class="fs-button"><ButtonLabel id="xr-sport-football-label" class="fs-label">Football</ButtonLabel></Button><Button id="xr-sport-f1" class="fs-button"><ButtonLabel id="xr-sport-f1-label" class="fs-label">F1</ButtonLabel></Button></div><div id="xr-football-teams"><div class="fs-row"><Button id="xr-team-barcelona" class="fs-button"><ButtonLabel id="xr-team-barcelona-label" class="fs-label">Barcelona</ButtonLabel></Button><Button id="xr-team-madrid" class="fs-button"><ButtonLabel id="xr-team-madrid-label" class="fs-label">Madrid</ButtonLabel></Button><Button id="xr-team-blue" class="fs-button"><ButtonLabel id="xr-team-blue-label" class="fs-label">Blue demo</ButtonLabel></Button><Button id="xr-team-amber" class="fs-button"><ButtonLabel id="xr-team-amber-label" class="fs-label">Amber demo</ButtonLabel></Button></div></div><div id="xr-f1-teams"><div class="fs-row"><Button id="xr-team-ferrari" class="fs-button"><ButtonLabel id="xr-team-ferrari-label" class="fs-label">Ferrari</ButtonLabel></Button><Button id="xr-team-mclaren" class="fs-button"><ButtonLabel id="xr-team-mclaren-label" class="fs-label">McLaren</ButtonLabel></Button></div></div><span id="xr-team-status" class="fs-body">Team: just watching</span><div class="fs-row"><Button id="xr-team-neutral" class="fs-button"><ButtonLabel id="xr-team-neutral-label" class="fs-label">Just watching</ButtonLabel></Button><Button id="xr-karaoke-toggle" class="fs-button"><ButtonLabel id="xr-karaoke-toggle-label" class="fs-label">Enable chant lyrics</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-start" class="fs-button"><ButtonLabel id="xr-start-label" class="fs-label">Start match</ButtonLabel></Button><Button id="xr-resume-saved" class="fs-button"><ButtonLabel id="xr-resume-saved-label" class="fs-label">Resume previous</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-resume" class="fs-button"><ButtonLabel id="xr-resume-label" class="fs-label">Resume match</ButtonLabel></Button><Button id="xr-watch-again" class="fs-button"><ButtonLabel id="xr-watch-again-label" class="fs-label">Watch again</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-library-back" class="fs-button"><ButtonLabel id="xr-library-back-label" class="fs-label">Back to match</ButtonLabel></Button><Button id="xr-recenter" class="fs-button"><ButtonLabel id="xr-recenter-label" class="fs-label">Recenter</ButtonLabel></Button><Button id="xr-exit" class="fs-button"><ButtonLabel id="xr-exit-label" class="fs-label">Exit VR</ButtonLabel></Button></div></div>