<style>
@font-face { font-family: 'Atkinson'; font-weight: 400; src: url('../fonts/AtkinsonHyperlegible-Regular.ttf'); font-weight: 400; }
.fs-root { font-family: 'Atkinson'; font-weight: 400; flex-direction: column; background-color: #1c2821; border-radius: 18px; padding: 24px; color: #edf3e8; gap: 12px; }
.fs-title { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #d5e5d0; }
.fs-body { font-family: 'Atkinson'; font-weight: 400; font-size: 24px; color: #b5c9b5; }
.fs-row { flex-direction: row; gap: 12px; align-items: center; justify-content: center; }
.fs-button { background-color: #304537; min-height: 62px; border-radius: 10px; padding: 10px; }
.fs-label { font-family: 'Atkinson'; font-weight: 400; font-size: 25px; color: #edf3e8; }
.fs-space { height: 275px; }
</style><div class="fs-root" style="width: 850px; height: 1100px"><div class="fs-title">SPORTS SPANISH COMPANION</div><div class="fs-body">Original football sample. Choose team colours, then watch in English. Switch commentary to Spanish when ready.</div><div class="fs-body">Point at a control and pinch to select it. Spanish audio plays only when you choose Listen. Learning stays beside the playing match. Pause is optional. You can hide learning prompts.</div><span id="xr-welcome-status" class="fs-body">Preparing your match...</span><div class="fs-row"><Button id="xr-sport-football" class="fs-button"><ButtonLabel id="xr-sport-football-label" class="fs-label">Football</ButtonLabel></Button><Button id="xr-sport-f1" class="fs-button"><ButtonLabel id="xr-sport-f1-label" class="fs-label">F1</ButtonLabel></Button></div><div id="xr-football-teams"><div class="fs-row"><Button id="xr-team-barcelona" class="fs-button"><ButtonLabel id="xr-team-barcelona-label" class="fs-label">FC Barcelona</ButtonLabel></Button><Button id="xr-team-madrid" class="fs-button"><ButtonLabel id="xr-team-madrid-label" class="fs-label">Real Madrid</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-team-blue" class="fs-button"><ButtonLabel id="xr-team-blue-label" class="fs-label">Blue demo team</ButtonLabel></Button><Button id="xr-team-amber" class="fs-button"><ButtonLabel id="xr-team-amber-label" class="fs-label">Amber demo team</ButtonLabel></Button></div></div><div id="xr-f1-teams"><div class="fs-row"><Button id="xr-team-ferrari" class="fs-button"><ButtonLabel id="xr-team-ferrari-label" class="fs-label">Ferrari</ButtonLabel></Button><Button id="xr-team-mclaren" class="fs-button"><ButtonLabel id="xr-team-mclaren-label" class="fs-label">McLaren</ButtonLabel></Button></div></div><span id="xr-team-status" class="fs-body">Team: just watching</span><div class="fs-row"><Button id="xr-team-neutral" class="fs-button"><ButtonLabel id="xr-team-neutral-label" class="fs-label">Just watching</ButtonLabel></Button><Button id="xr-karaoke-toggle" class="fs-button"><ButtonLabel id="xr-karaoke-toggle-label" class="fs-label">Enable chant lyrics</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-start" class="fs-button"><ButtonLabel id="xr-start-label" class="fs-label">Start match</ButtonLabel></Button><Button id="xr-resume-saved" class="fs-button"><ButtonLabel id="xr-resume-saved-label" class="fs-label">Resume previous</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-resume" class="fs-button"><ButtonLabel id="xr-resume-label" class="fs-label">Resume match</ButtonLabel></Button><Button id="xr-watch-again" class="fs-button"><ButtonLabel id="xr-watch-again-label" class="fs-label">Watch again</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-library-back" class="fs-button"><ButtonLabel id="xr-library-back-label" class="fs-label">Back to match</ButtonLabel></Button><Button id="xr-recenter" class="fs-button"><ButtonLabel id="xr-recenter-label" class="fs-label">Recenter</ButtonLabel></Button><Button id="xr-exit" class="fs-button"><ButtonLabel id="xr-exit-label" class="fs-label">Exit VR</ButtonLabel></Button></div></div>