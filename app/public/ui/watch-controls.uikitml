<style>
@font-face { font-family: 'Atkinson'; font-weight: 400; src: url('../fonts/AtkinsonHyperlegible-Regular.ttf'); font-weight: 400; }
.fs-root { font-family: 'Atkinson'; font-weight: 400; flex-direction: column; background-color: #1c2821; border-radius: 18px; padding: 24px; color: #edf3e8; gap: 12px; }
.fs-title { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #d5e5d0; }
.fs-body { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #b5c9b5; }
.fs-row { flex-direction: row; gap: 12px; align-items: center; justify-content: center; }
.fs-button { background-color: #304537; min-height: 62px; border-radius: 10px; padding: 10px; }
.fs-label { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #edf3e8; }
.fs-space { height: 275px; }
</style><div class="fs-root" style="width: 1100px; height: 320px"><span id="xr-team-identity" class="fs-body">Football / Just watching</span><span id="xr-caption" class="fs-body">Original simulated match</span><span id="xr-time" class="fs-body">00:00 / 00:30</span><div class="fs-row"><Button id="xr-play" class="fs-button"><ButtonLabel id="xr-play-label" class="fs-label">Play</ButtonLabel></Button><Button id="xr-restart" class="fs-button"><ButtonLabel id="xr-restart-label" class="fs-label">Restart</ButtonLabel></Button><Button id="xr-library" class="fs-button"><ButtonLabel id="xr-library-label" class="fs-label">Your phrases</ButtonLabel></Button><Button id="xr-commentary" class="fs-button"><ButtonLabel id="xr-commentary-label" class="fs-label">Switch to Spanish</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-mute" class="fs-button"><ButtonLabel id="xr-mute-label" class="fs-label">Mute</ButtonLabel></Button><Button id="xr-hide" class="fs-button"><ButtonLabel id="xr-hide-label" class="fs-label">Hide prompts</ButtonLabel></Button><Button id="xr-side" class="fs-button"><ButtonLabel id="xr-side-label" class="fs-label">Panel left</ButtonLabel></Button><Button id="xr-coach-open" class="fs-button"><ButtonLabel id="xr-coach-open-label" class="fs-label">AI coach</ButtonLabel></Button></div></div>