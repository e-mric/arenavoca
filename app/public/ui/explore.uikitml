<style>
@font-face { font-family: 'Atkinson'; font-weight: 400; src: url('../fonts/AtkinsonHyperlegible-Regular.ttf'); font-weight: 400; }
.fs-root { font-family: 'Atkinson'; font-weight: 400; flex-direction: column; background-color: #1c2821; border-radius: 18px; padding: 24px; color: #edf3e8; gap: 12px; }
.fs-title { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #d5e5d0; }
.fs-body { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #b5c9b5; }
.fs-row { flex-direction: row; gap: 12px; align-items: center; justify-content: center; }
.fs-button { background-color: #304537; min-height: 62px; border-radius: 10px; padding: 10px; }
.fs-label { font-family: 'Atkinson'; font-weight: 400; font-size: 32px; color: #edf3e8; }
.fs-space { height: 275px; }
</style><div class="fs-root" style="width: 1000px; height: 1000px"><div id="xr-explore-mode" class="fs-body">MATCH PLAYING / TRACE THE PASS</div><span id="xr-chunks" class="fs-title">Follow the pass to reveal the sentence</span><div id="xr-trace-area" class="fs-space" style="height: 500px"></div><span id="xr-trace-status" class="fs-body">Choose a hand, then follow the ball.</span><div class="fs-row"><Button id="xr-trace-right" class="fs-button"><ButtonLabel id="xr-trace-right-label" class="fs-label">Trace right hand</ButtonLabel></Button><Button id="xr-trace-left" class="fs-button"><ButtonLabel id="xr-trace-left-label" class="fs-label">Trace left hand</ButtonLabel></Button><Button id="xr-replay" class="fs-button"><ButtonLabel id="xr-replay-label" class="fs-label">Replay action</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-explore-listen" class="fs-button"><ButtonLabel id="xr-explore-listen-label" class="fs-label">Listen</ButtonLabel></Button><Button id="xr-explore-save" class="fs-button"><ButtonLabel id="xr-explore-save-label" class="fs-label">Save phrase</ButtonLabel></Button><Button id="xr-explore-play" class="fs-button"><ButtonLabel id="xr-explore-play-label" class="fs-label">Pause match</ButtonLabel></Button><Button id="xr-back" class="fs-button"><ButtonLabel id="xr-back-label" class="fs-label">Close companion</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-explore-commentary" class="fs-button"><ButtonLabel id="xr-explore-commentary-label" class="fs-label">Spanish commentary</ButtonLabel></Button></div><div class="fs-row"><Button id="xr-explore-side" class="fs-button"><ButtonLabel id="xr-explore-side-label" class="fs-label">Panel left</ButtonLabel></Button><Button id="xr-panel-distance" class="fs-button"><ButtonLabel id="xr-panel-distance-label" class="fs-label">Panel farther</ButtonLabel></Button><Button id="xr-panel-height" class="fs-button"><ButtonLabel id="xr-panel-height-label" class="fs-label">Panel higher</ButtonLabel></Button></div></div>